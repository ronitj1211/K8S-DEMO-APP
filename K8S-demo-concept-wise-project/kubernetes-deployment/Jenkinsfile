// Jenkins declarative pipeline for the kubernetes-deployment demo.
//
// This is the canonical push-to-deploy shape: build image, push to registry,
// update the Deployment via `kubectl set image`, wait for rolling update to
// stabilize. The Deployment does the actual rolling replace of Pods.
//
// Prerequisites in Jenkins:
//   - Credentials 'dockerhub-creds'  (registry user/pass)
//   - Credentials 'kubeconfig'       (secret file kubeconfig)
//   - Docker + kubectl on the agent

pipeline {
    agent any

    environment {
        REGISTRY       = 'ghcr.io/ronitj1211'
        BACKEND_IMAGE  = "${REGISTRY}/k8s-demo-backend"
        FRONTEND_IMAGE = "${REGISTRY}/k8s-demo-frontend"
        IMAGE_TAG      = "${env.GIT_COMMIT?.take(7) ?: env.BUILD_NUMBER}"
        NAMESPACE      = 'default'
        MANIFEST_DIR   = 'K8S-demo-concept-wise-project/kubernetes-deployment'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Build & push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'REG_USER',
                    passwordVariable: 'REG_PASS'
                )]) {
                    sh '''
                      echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin

                      docker build -t "${BACKEND_IMAGE}:${IMAGE_TAG}" -t "${BACKEND_IMAGE}:latest" \
                                   "${MANIFEST_DIR}/backend"
                      docker build -t "${FRONTEND_IMAGE}:${IMAGE_TAG}" -t "${FRONTEND_IMAGE}:latest" \
                                   "${MANIFEST_DIR}/frontend"

                      docker push "${BACKEND_IMAGE}:${IMAGE_TAG}"
                      docker push "${BACKEND_IMAGE}:latest"
                      docker push "${FRONTEND_IMAGE}:${IMAGE_TAG}"
                      docker push "${FRONTEND_IMAGE}:latest"
                    '''
                }
            }
        }

        stage('Apply manifests') {
            // First time or on YAML changes, apply the Deployments. `kubectl apply`
            // is a no-op if nothing changed (except image, which we set below).
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/backend/backend-deployment.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/frontend/frontend-deployment.yaml
                    """
                }
            }
        }

        stage('Roll to new image') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} set image deployment/backend-deployment \
                        backend=${BACKEND_IMAGE}:${IMAGE_TAG} --record

                      kubectl -n ${NAMESPACE} set image deployment/frontend-deployment \
                        frontend=${FRONTEND_IMAGE}:${IMAGE_TAG} --record
                    """
                }
            }
        }

        stage('Wait for rollout') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    // rollout status blocks until success or timeout — non-zero exit on fail.
                    sh """
                      kubectl -n ${NAMESPACE} rollout status deployment/backend-deployment  --timeout=5m
                      kubectl -n ${NAMESPACE} rollout status deployment/frontend-deployment --timeout=5m
                    """
                }
            }
        }

        stage('Verify version') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      POD=\$(kubectl -n ${NAMESPACE} get pod -l app=backend -o jsonpath='{.items[0].metadata.name}')
                      RESP=\$(kubectl -n ${NAMESPACE} exec \$POD -- wget -qO- http://localhost:3000/)
                      echo "\$RESP"
                      echo "\$RESP" | grep -q hostname
                      echo '✅ backend responding'
                    """
                }
            }
        }
    }

    post {
        failure {
            echo "Rollout failed. Auto-rolling-back to previous revision."
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                sh """
                  kubectl -n ${NAMESPACE} rollout undo deployment/backend-deployment
                  kubectl -n ${NAMESPACE} rollout undo deployment/frontend-deployment
                """
            }
        }
        success {
            echo "✅ Deployment rolled successfully — tag ${IMAGE_TAG}"
        }
        always {
            sh 'docker logout $REGISTRY || true'
        }
    }
}
