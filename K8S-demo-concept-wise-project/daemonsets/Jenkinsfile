// Jenkins declarative pipeline for the daemonsets demo.
//
// DaemonSet rollouts happen node-by-node. We wait for rollout status and check
// that the DS's ready count matches the number of matching nodes.

pipeline {
    agent any

    environment {
        REGISTRY      = 'ghcr.io/ronitj1211'
        AGENT_IMG     = "${REGISTRY}/k8s-demo-node-agent"
        FRONTEND_IMG  = "${REGISTRY}/k8s-demo-frontend"
        IMAGE_TAG     = "${env.GIT_COMMIT?.take(7) ?: env.BUILD_NUMBER}"
        NAMESPACE     = 'default'
        MANIFEST_DIR  = 'K8S-demo-concept-wise-project/daemonsets'
    }

    options { timeout(time: 20, unit: 'MINUTES'); disableConcurrentBuilds() }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Build & push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS'
                )]) {
                    sh '''
                      echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
                      docker build -t "${AGENT_IMG}:${IMAGE_TAG}"    -t "${AGENT_IMG}:latest"    "${MANIFEST_DIR}/backend"
                      docker build -t "${FRONTEND_IMG}:${IMAGE_TAG}" -t "${FRONTEND_IMG}:latest" "${MANIFEST_DIR}/frontend"
                      docker push  "${AGENT_IMG}:${IMAGE_TAG}";    docker push "${AGENT_IMG}:latest"
                      docker push  "${FRONTEND_IMG}:${IMAGE_TAG}"; docker push "${FRONTEND_IMG}:latest"
                    '''
                }
            }
        }

        stage('Apply DaemonSet + Service + frontend') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/backend/node-agent-daemonset.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/backend/node-agent-service.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/frontend/frontend.yaml
                    """
                }
            }
        }

        stage('Roll images') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} set image daemonset/node-agent    agent=${AGENT_IMG}:${IMAGE_TAG}    --record
                      kubectl -n ${NAMESPACE} set image deployment/frontend      frontend=${FRONTEND_IMG}:${IMAGE_TAG} --record
                    """
                }
            }
        }

        stage('Wait for DS rollout') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    // DaemonSet rolls one node at a time (maxUnavailable: 1 default).
                    // On a 100-node cluster, this is deliberately slow to keep node
                    // coverage during the upgrade.
                    sh """
                      kubectl -n ${NAMESPACE} rollout status daemonset/node-agent --timeout=10m
                      kubectl -n ${NAMESPACE} rollout status deployment/frontend --timeout=5m

                      # DS's DESIRED should equal READY (one Pod per matching node)
                      kubectl -n ${NAMESPACE} get daemonset node-agent
                      DESIRED=\$(kubectl -n ${NAMESPACE} get ds node-agent -o jsonpath='{.status.desiredNumberScheduled}')
                      READY=\$(kubectl -n ${NAMESPACE} get ds node-agent -o jsonpath='{.status.numberReady}')
                      [ "\$DESIRED" = "\$READY" ] || { echo "❌ DS ready=\$READY, expected \$DESIRED"; exit 1; }
                      echo "✅ DS covers all \$DESIRED matching nodes"
                    """
                }
            }
        }
    }

    post {
        failure {
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                sh "kubectl -n ${NAMESPACE} rollout undo daemonset/node-agent  || true"
                sh "kubectl -n ${NAMESPACE} rollout undo deployment/frontend    || true"
            }
        }
        always { sh 'docker logout $REGISTRY || true' }
    }
}
