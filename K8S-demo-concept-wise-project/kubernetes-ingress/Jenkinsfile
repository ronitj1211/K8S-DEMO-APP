// Jenkins declarative pipeline for the kubernetes-ingress demo.
//
// Requires an Ingress controller (ingress-nginx or similar) already installed in
// the cluster. This pipeline deploys the backend/frontend + Ingress rule.
//
// If you're on EKS with AWS Load Balancer Controller, swap `ingressClassName: nginx`
// for `alb` in the Ingress manifest and the controller will provision an ALB.

pipeline {
    agent any

    environment {
        REGISTRY       = 'ghcr.io/ronitj1211'
        BACKEND_IMG    = "${REGISTRY}/k8s-demo-backend"
        FRONTEND_IMG   = "${REGISTRY}/k8s-demo-frontend"
        IMAGE_TAG      = "${env.GIT_COMMIT?.take(7) ?: env.BUILD_NUMBER}"
        NAMESPACE      = 'default'
        MANIFEST_DIR   = 'K8S-demo-concept-wise-project/kubernetes-ingress'
        DEMO_HOST      = 'demo.local'   // set via /etc/hosts or DNS
    }

    options { timeout(time: 20, unit: 'MINUTES'); disableConcurrentBuilds() }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Preflight — Ingress controller exists') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                      # Check for an IngressClass named `nginx` (or update this if you use `alb`)
                      kubectl get ingressclass nginx >/dev/null 2>&1 || {
                        echo "❌ No IngressClass named 'nginx' found."
                        echo "   Install ingress-nginx or update the Ingress manifest to match an existing IngressClass."
                        kubectl get ingressclass
                        exit 1
                      }
                      echo "✅ ingress-nginx present"
                    '''
                }
            }
        }

        stage('Build & push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS'
                )]) {
                    sh '''
                      echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
                      docker build -t "${BACKEND_IMG}:${IMAGE_TAG}"  -t "${BACKEND_IMG}:latest"  "${MANIFEST_DIR}/backend"
                      docker build -t "${FRONTEND_IMG}:${IMAGE_TAG}" -t "${FRONTEND_IMG}:latest" "${MANIFEST_DIR}/frontend"
                      docker push  "${BACKEND_IMG}:${IMAGE_TAG}";  docker push "${BACKEND_IMG}:latest"
                      docker push  "${FRONTEND_IMG}:${IMAGE_TAG}"; docker push "${FRONTEND_IMG}:latest"
                    '''
                }
            }
        }

        stage('Apply Deployments + Services + Ingress') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/backend/backend.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/frontend/frontend.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/ingress.yaml
                    """
                }
            }
        }

        stage('Roll images + wait') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} set image deployment/backend  backend=${BACKEND_IMG}:${IMAGE_TAG}   --record
                      kubectl -n ${NAMESPACE} set image deployment/frontend frontend=${FRONTEND_IMG}:${IMAGE_TAG} --record
                      kubectl -n ${NAMESPACE} rollout status deployment/backend  --timeout=5m
                      kubectl -n ${NAMESPACE} rollout status deployment/frontend --timeout=5m
                    """
                }
            }
        }

        stage('Wait for Ingress to get an address') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                      for i in $(seq 1 24); do
                        ADDR=$(kubectl -n ${NAMESPACE} get ingress demo-ingress -o jsonpath='{.status.loadBalancer.ingress[0].hostname}{.status.loadBalancer.ingress[0].ip}')
                        if [ -n "$ADDR" ]; then
                          echo "✅ Ingress ADDRESS = $ADDR"
                          exit 0
                        fi
                        echo "waiting for Ingress ADDRESS ($i/24)..."
                        sleep 5
                      done
                      echo "❌ Ingress never got an ADDRESS — controller may be misconfigured"
                      kubectl -n ${NAMESPACE} describe ingress demo-ingress
                      exit 1
                    '''
                }
            }
        }

        stage('Smoke test via Ingress') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      ADDR=\$(kubectl -n ${NAMESPACE} get ingress demo-ingress -o jsonpath='{.status.loadBalancer.ingress[0].hostname}{.status.loadBalancer.ingress[0].ip}')
                      curl -sf -H 'Host: ${DEMO_HOST}' http://\$ADDR/api/hello | grep -q hostname
                      echo '✅ Ingress routing /api/* → backend'
                    """
                }
            }
        }
    }

    post {
        failure {
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                sh "kubectl -n ${NAMESPACE} rollout undo deployment/backend  || true"
                sh "kubectl -n ${NAMESPACE} rollout undo deployment/frontend || true"
            }
        }
        always { sh 'docker logout $REGISTRY || true' }
    }
}
