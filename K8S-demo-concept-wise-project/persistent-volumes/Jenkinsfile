// Jenkins pipeline for the persistent-volumes demo.
// Validates PVC binding before rollout and confirms data survives a Pod restart.

pipeline {
    agent any

    environment {
        REGISTRY      = 'ghcr.io/ronitj1211'
        BACKEND_IMG   = "${REGISTRY}/pv-demo-backend"
        UI_IMG        = "${REGISTRY}/pv-demo-ui"
        IMAGE_TAG     = "${env.GIT_COMMIT?.take(7) ?: env.BUILD_NUMBER}"
        NAMESPACE     = 'default'
        MANIFEST_DIR  = 'K8S-demo-concept-wise-project/persistent-volumes'
    }

    options { timeout(time: 20, unit: 'MINUTES'); disableConcurrentBuilds() }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Build & push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS'
                )]) {
                    sh '''
                      echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
                      docker build -t "${BACKEND_IMG}:${IMAGE_TAG}" -t "${BACKEND_IMG}:latest" "${MANIFEST_DIR}/backend"
                      docker build -t "${UI_IMG}:${IMAGE_TAG}"      -t "${UI_IMG}:latest"      "${MANIFEST_DIR}/frontend"
                      docker push  "${BACKEND_IMG}:${IMAGE_TAG}"; docker push "${BACKEND_IMG}:latest"
                      docker push  "${UI_IMG}:${IMAGE_TAG}";      docker push "${UI_IMG}:latest"
                    '''
                }
            }
        }

        stage('Apply PVC + Deployment') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/backend/02-pvc.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/backend/03-deployment.yaml
                      kubectl -n ${NAMESPACE} apply -f ${MANIFEST_DIR}/frontend/frontend.yaml
                      kubectl -n ${NAMESPACE} set image deployment/notes app=${BACKEND_IMG}:${IMAGE_TAG}
                      kubectl -n ${NAMESPACE} set image deployment/notes-ui ui=${UI_IMG}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Wait for PVC binding') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      kubectl -n ${NAMESPACE} wait --for=jsonpath='{.status.phase}'=Bound pvc/notes-data --timeout=3m
                      kubectl -n ${NAMESPACE} rollout status deployment/notes --timeout=3m
                      kubectl -n ${NAMESPACE} rollout status deployment/notes-ui --timeout=3m
                    """
                }
            }
        }

        stage('Verify API + persistence') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                      POD=\$(kubectl -n ${NAMESPACE} get pod -l app=notes -o jsonpath='{.items[0].metadata.name}')
                      kubectl -n ${NAMESPACE} exec "\$POD" -- wget -qO- --post-data='' http://localhost:3000/inc > /dev/null
                      kubectl -n ${NAMESPACE} exec "\$POD" -- wget -qO- http://localhost:3000/health | grep -q ok

                      kubectl -n ${NAMESPACE} delete pod "\$POD" --wait=true
                      kubectl -n ${NAMESPACE} rollout status deployment/notes --timeout=3m

                      NEW_POD=\$(kubectl -n ${NAMESPACE} get pod -l app=notes -o jsonpath='{.items[0].metadata.name}')
                      COUNTER=\$(kubectl -n ${NAMESPACE} exec "\$NEW_POD" -- wget -qO- http://localhost:3000/ | grep -o '"counter":[0-9]*' | cut -d: -f2)
                      test "\$COUNTER" -ge 1 && echo "✅ counter persisted across Pod restart (\$COUNTER)"
                    """
                }
            }
        }
    }

    post {
        failure {
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                sh "kubectl -n ${NAMESPACE} rollout undo deployment/notes || true"
                sh "kubectl -n ${NAMESPACE} rollout undo deployment/notes-ui || true"
            }
        }
        always { sh 'docker logout $REGISTRY || true' }
    }
}
